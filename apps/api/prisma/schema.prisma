// SpruVex R — Prisma schema
// Phase 0: Identity & Tenancy domain + audit log.
//
// Conventions (see architecture plan §9.2):
// - UUID primary keys.
// - tenant_id on every tenant-owned table (enforced twice: Prisma tenant client + Postgres RLS).
// - created_at / updated_at / created_by / updated_by on business tables.
// - Soft delete via deleted_at (invoices, added in Phase 7, are append-only instead).
// - Money is NUMERIC / integer halalas — never float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime URL (spruvex_app, RLS enforced). Prisma CLI (migrate/seed) uses directUrl.
  url       = env("DATABASE_URL")
  directUrl = env("ADMIN_DATABASE_URL")
}

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}

model Tenant {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  nameEn                String?      @map("name_en")
  slug                  String       @unique
  logoUrl               String?      @map("logo_url")
  /// ZATCA: registered legal entity name (falls back to `name` on invoices).
  legalName             String?      @map("legal_name")
  vatNumber             String?      @map("vat_number")
  crNumber              String?      @map("cr_number")
  /// ZATCA: registered address of the establishment (street name / line 1).
  address               String?
  /// National Address components (KSA tax-invoice seller address, ZATCA
  /// PostalAddress block) — collected as mandatory onboarding fields
  /// alongside vatNumber/crNumber, same compliance reason.
  city                  String?
  district              String?
  additionalAddress     String?      @map("additional_address")
  buildingNumber        String?      @map("building_number")
  postalCode            String?      @map("postal_code")
  /// Restaurant's main contact number (distinct from any one branch's phone).
  contactPhone          String?      @map("contact_phone")
  status                TenantStatus @default(active)
  /// Business type: restaurant | cafe | cloud_kitchen | food_truck | bakery | other
  type                  String?
  /// ISO 3166-1 alpha-2
  country               String       @default("SA")
  /// ISO 4217
  currency              String       @default("SAR")
  /// Default UI language for the tenant: ar | en
  defaultLocale         String       @default("ar") @map("default_locale")
  /// VAT rate percent, configurable (KSA default 15.00)
  vatRate               Decimal      @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  settings              Json         @default("{}")
  onboardingCompletedAt DateTime?    @map("onboarding_completed_at")

  /// Printed-receipt customization — optional onboarding step, editable
  /// later from settings. themeColor is one of THEME_PRESETS
  /// (@spruvex-r/types) — a curated, contrast-checked key, never a raw
  /// user-picked hex (better-colors: never ship an unverified color pair).
  themeColor          String  @default("green") @map("theme_color")
  receiptHeaderNote   String? @map("receipt_header_note")
  receiptFooterNote   String? @map("receipt_footer_note")
  /// One of RECEIPT_TEMPLATE_KEYS (@spruvex-r/types) — snapshotted into
  /// Receipt.payload at issuance, so changing it never retroactively alters
  /// an already-issued invoice.
  receiptTemplate     String  @default("classic") @map("receipt_template")
  /// One of RECEIPT_LOGO_POSITIONS.
  receiptLogoPosition String  @default("top-center") @map("receipt_logo_position")
  /// One of RECEIPT_LOGO_SIZES.
  receiptLogoSize     String  @default("medium") @map("receipt_logo_size")

  /// Public digital-menu (apps/ordering) appearance. One of MENU_TEMPLATE_KEYS
  /// (@spruvex-r/types), or "custom" to use menuCustomCss instead of a preset.
  menuTemplate  String  @default("classic") @map("menu_template")
  /// Sanitized (never raw) CSS — see shared/security/menu-css-sanitizer.ts.
  /// Only meaningful when menuTemplate = "custom". Already scoped under
  /// .spx-menu-custom by the sanitizer before it's ever stored.
  menuCustomCss String? @map("menu_custom_css") @db.Text

  /// ZATCA Phase 2 (Fatoora integration) — opt-in per restaurant (plan
  /// decision: owner enables it only once their revenue wave actually
  /// requires it; Phase 1's QR-only invoice keeps working either way).
  zatcaPhase2Enabled      Boolean @default(false) @map("zatca_phase2_enabled")
  /// "sandbox" while onboarding with ZATCA's compliance CSID, "production"
  /// once the production CSID is issued. Irrelevant while disabled.
  zatcaEnvironment        String  @default("sandbox") @map("zatca_environment")
  /// Compliance/production CSID materials from the Fatoora portal, at rest
  /// AES-256-GCM encrypted (see shared/security/crypto-vault.ts) — never
  /// selected into an API response.
  zatcaCsidCertificateEnc String? @map("zatca_csid_certificate_enc") @db.Text
  zatcaCsidPrivateKeyEnc  String? @map("zatca_csid_private_key_enc") @db.Text
  /// The CSID binarySecurityToken (Basic-auth username against Fatoora) —
  /// not as sensitive as the private key/secret, but still credential
  /// material, so encrypted the same way.
  zatcaCsidTokenEnc       String? @map("zatca_csid_token_enc") @db.Text
  zatcaCsidSecretEnc      String? @map("zatca_csid_secret_enc") @db.Text
  /// Free-text note for the settings page (e.g. onboarding request date) —
  /// not itself credential material.
  zatcaCsidRequestId      String? @map("zatca_csid_request_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  branches                  Branch[]
  roles                     Role[]
  userRoles                 UserRole[]
  posPins                   PosPin[]
  auditLogs                 AuditLog[]
  categories                Category[]
  products                  Product[]
  productBranchSettings     ProductBranchSetting[]
  modifierGroups            ModifierGroup[]
  modifiers                 Modifier[]
  productModifierGroups     ProductModifierGroup[]
  floors                    Floor[]
  tables                    Table[]
  tableSessions             TableSession[]
  tableSessionParticipants  TableSessionParticipant[]
  orders                    Order[]
  orderAppendLogs           OrderAppendLog[]
  orderItems                OrderItem[]
  orderItemModifiers        OrderItemModifier[]
  orderStatusHistories      OrderStatusHistory[]
  shifts                    Shift[]
  payments                  Payment[]
  receipts                  Receipt[]
  creditNotes               CreditNote[]
  debitNotes                DebitNote[]
  refunds                   Refund[]
  branchInvoiceChains       BranchInvoiceChain[]
  ingredients               Ingredient[]
  stockLocations            StockLocation[]
  stockLevels               StockLevel[]
  stockMovements            StockMovement[]
  recipeItems               RecipeItem[]
  subscription              Subscription?
  subscriptionInvoices      SubscriptionInvoice[]
  integrationConnections    IntegrationConnection[]
  deliveryProductMappings   DeliveryProductMapping[]
  whatsappTemplateOverrides WhatsappTemplateOverride[]
  productStockHides         ProductStockHide[]
  orderFeedbackRequests     OrderFeedbackRequest[]
  loyaltyProgramConfigs     LoyaltyProgramConfig[]
  loyaltyCustomers          LoyaltyCustomer[]
  loyaltyLedgerEntries      LoyaltyLedgerEntry[]
  suppliers                 Supplier[]
  purchaseInvoices          PurchaseInvoice[]
  purchaseInvoiceItems      PurchaseInvoiceItem[]
  expenses                  Expense[]

  @@map("tenants")
}

model Branch {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  nameEn           String?  @map("name_en")
  slug             String
  address          String?
  phone            String?
  email            String?
  lat              Decimal? @db.Decimal(9, 6)
  lng              Decimal? @db.Decimal(9, 6)
  /// Weekly working hours, e.g. {"sun": [{"from": "08:00", "to": "23:00"}], ...}
  workingHours     Json     @default("{}") @map("working_hours")
  /// Self-ordering settings, e.g. {"qrOrderingEnabled": true, "requireCashierConfirmation": false}
  orderingSettings Json     @default("{}") @map("ordering_settings")
  isActive         Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  userRoles              UserRole[]
  posPins                PosPin[]
  productBranchSettings  ProductBranchSetting[]
  floors                 Floor[]
  tables                 Table[]
  orders                 Order[]
  shifts                 Shift[]
  stockLocations         StockLocation[]
  stockLevels            StockLevel[]
  stockMovements         StockMovement[]
  invoiceChain           BranchInvoiceChain?
  integrationConnections IntegrationConnection[]
  productStockHides      ProductStockHide[]
  feedbackRequests       OrderFeedbackRequest[]
  loyaltyProgramConfigs  LoyaltyProgramConfig[]
  loyaltyLedgerEntries   LoyaltyLedgerEntry[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("branches")
}

/// Users are a global identity (email/phone unique across the platform);
/// tenant membership and scope are expressed through user_roles.
model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  phone        String? @unique
  passwordHash String  @map("password_hash")
  name         String
  isActive     Boolean @default(true) @map("is_active")

  emailVerifiedAt     DateTime? @map("email_verified_at")
  lastLoginAt         DateTime? @map("last_login_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  /// Account lockout after repeated failed logins.
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userRoles     UserRole[]
  posPins       PosPin[]
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]

  @@map("users")
}

/// Refresh-token sessions (global identity table, like users — no tenant_id).
/// Tokens are opaque random secrets stored hashed. Rotation: each refresh
/// revokes the old token and issues a new one in the same family; presenting
/// a revoked token (reuse) revokes the entire family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// One-time codes for email/phone verification and password reset.
/// OTP-ready architecture: delivery goes through the OtpSender port —
/// development logs the code; a real SMS/email provider plugs in later.
model OtpCode {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  /// email_verification | password_reset | login
  purpose     String
  /// email address or phone number the code was sent to
  destination String
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  attempts    Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([destination, purpose])
  @@map("otp_codes")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  /// Machine key, e.g. "owner", "manager" — unique per tenant.
  key      String
  nameAr   String  @map("name_ar")
  nameEn   String  @map("name_en")
  /// Built-in roles cannot be deleted (their permissions can still be edited).
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

/// Global permission catalog (seeded from @spruvex-r/types PERMISSIONS).
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  /// e.g. "orders.void"
  key         String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  roleId   String  @map("role_id") @db.Uuid
  /// null = role applies tenant-wide (all branches)
  branchId String? @map("branch_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])
  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, roleId, tenantId, branchId])
  @@index([tenantId])
  @@index([userId])
  @@map("user_roles")
}

/// Hashed PIN per user per branch for fast cashier switching on the POS.
model PosPin {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  pinHash  String @map("pin_hash")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([branchId, userId])
  @@index([tenantId])
  @@map("pos_pins")
}

/// Append-only audit trail for sensitive actions (void, discount over limit,
/// drawer open without sale, permission changes, stock adjustments, ...).
/// UPDATE/DELETE are revoked from the app role at the database level.
model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  branchId   String? @map("branch_id") @db.Uuid
  userId     String? @map("user_id") @db.Uuid
  action     String
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid
  /// Structured context: reason, before/after values, amounts...
  meta       Json    @default("{}")
  ip         String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("audit_logs")
}

// ============================================================================
// Catalog domain (Phase 2) — the single source of truth for every ordering
// channel (POS, QR menu, future channels).
// Menu structure: Category -> Product -> ModifierGroup -> Modifier.
// ============================================================================

model Category {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  /// Arabic name (primary)
  name          String
  nameEn        String? @map("name_en")
  description   String?
  descriptionEn String? @map("description_en")
  imageUrl      String? @map("image_url")
  sortOrder     Int     @default(0) @map("sort_order")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId, sortOrder])
  @@map("categories")
}

model Product {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  /// Arabic name (primary)
  name          String
  nameEn        String? @map("name_en")
  description   String?
  descriptionEn String? @map("description_en")
  imageUrl      String? @map("image_url")
  /// Internal code / SKU — unique per tenant when set
  sku           String?

  /// Base price in SAR (NUMERIC — never float). Branches may override.
  basePrice Decimal  @map("base_price") @db.Decimal(12, 2)
  /// VAT rate percent override; null = tenant default (15%). Tax-config readiness.
  taxRate   Decimal? @map("tax_rate") @db.Decimal(5, 2)

  sortOrder            Int     @default(0) @map("sort_order")
  isActive             Boolean @default(true) @map("is_active")
  /// Availability windows (e.g. breakfast-only) — schema readiness, enforced in a later phase.
  availabilitySchedule Json    @default("{}") @map("availability_schedule")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  category                Category                 @relation(fields: [categoryId], references: [id])
  branchSettings          ProductBranchSetting[]
  modifierGroups          ProductModifierGroup[]
  orderItems              OrderItem[]
  recipeItems             RecipeItem[]
  deliveryProductMappings DeliveryProductMapping[]
  stockHides              ProductStockHide[]
  feedbackRequests        OrderFeedbackRequest[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@map("products")
}

/// Per-branch availability and price override for a product.
model ProductBranchSetting {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid

  /// null = product base price applies
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  isAvailable   Boolean  @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
  @@index([tenantId, branchId])
  @@map("product_branch_settings")
}

/// e.g. "الحجم / Size", "إضافات / Extras", "الصوصات / Sauces"
model ModifierGroup {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Arabic name (primary)
  name   String
  nameEn String? @map("name_en")

  /// Required groups need at least minSelect choices at order time.
  isRequired Boolean @default(false) @map("is_required")
  minSelect  Int     @default(0) @map("min_select")
  /// null = unlimited
  maxSelect  Int?    @map("max_select")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@index([tenantId])
  @@map("modifier_groups")
}

/// e.g. "كبير +5", "جبنة إضافية +3"
model Modifier {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid

  /// Arabic name (primary)
  name   String
  nameEn String? @map("name_en")

  /// Price delta in SAR (NUMERIC — never float). Can be negative.
  priceAdjustment Decimal @default(0) @map("price_adjustment") @db.Decimal(12, 2)

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  group              ModifierGroup       @relation(fields: [modifierGroupId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@index([tenantId, modifierGroupId])
  @@map("modifiers")
}

/// Attaches modifier groups to products (ordered).
model ProductModifierGroup {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  modifierGroupId String @map("modifier_group_id") @db.Uuid
  sortOrder       Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  product Product       @relation(fields: [productId], references: [id])
  group   ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@unique([productId, modifierGroupId])
  @@index([tenantId])
  @@map("product_modifier_groups")
}

// ============================================================================
// Tables domain (Phase 3) — floors/areas, tables with permanent QR tokens,
// and table sessions (the anchor future orders attach to).
// ============================================================================

/// Floor / area inside a branch: Main Hall, Outdoor, VIP...
model Floor {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  /// Arabic name (primary)
  name      String
  nameEn    String? @map("name_en")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch  @relation(fields: [branchId], references: [id])
  tables Table[]

  @@index([tenantId, branchId])
  @@map("floors")
}

enum TableStatus {
  available
  occupied
  reserved
  disabled

  @@map("table_status")
}

model Table {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  floorId  String @map("floor_id") @db.Uuid

  /// Custom table number/name, e.g. "12" or "A1" — unique per branch (partial index in migration)
  number   String
  capacity Int         @default(4)
  status   TableStatus @default(available)

  /// Permanent, non-guessable QR token — the public identifier used in QR URLs.
  /// Database IDs are never exposed. Regeneration replaces the token, which
  /// disables the old QR (lookups by the old token fail).
  qrToken       String   @unique @map("qr_token")
  qrGeneratedAt DateTime @default(now()) @map("qr_generated_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  branch   Branch         @relation(fields: [branchId], references: [id])
  floor    Floor          @relation(fields: [floorId], references: [id])
  sessions TableSession[]
  orders   Order[]

  @@index([tenantId, branchId])
  @@map("tables")
}

/// A dining session: everyone seated at a table, identified by their own
/// phone number, sharing ONE real order/invoice. At most one open session
/// per table (enforced by a partial unique index — see migration SQL);
/// `OrderingService` finds-or-creates it on the first QR scan and every
/// later scan of the same table joins it as a new `TableSessionParticipant`
/// instead of starting a separate bill.
model TableSession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  tableId  String @map("table_id") @db.Uuid

  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")
  openedBy String?   @map("opened_by") @db.Uuid
  closedBy String?   @map("closed_by") @db.Uuid
  notes    String?

  /// Bumped on every join/order/append — the inactivity-timeout poller's clock.
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  /// Set when the timeout poller found the session stale but would NOT
  /// auto-close it (its order has an unpaid balance) — surfaced to the
  /// cashier's open-sessions view instead of silently closing. Cleared on
  /// the next activity or on manual close.
  staleFlaggedAt DateTime? @map("stale_flagged_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  table        Table                     @relation(fields: [tableId], references: [id])
  orders       Order[]
  participants TableSessionParticipant[]

  @@index([tableId, closedAt])
  @@index([tenantId, branchId])
  @@map("table_sessions")
}

/// One phone number that has joined a table session — the identity used to
/// attribute `OrderItem`s for per-person bill splitting, and the recipient
/// list for order-status WhatsApp notifications (the same phone identity
/// loyalty/ratings already use elsewhere).
model TableSessionParticipant {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  tableSessionId String @map("table_session_id") @db.Uuid

  phone String
  name  String?

  joinedAt       DateTime @default(now()) @map("joined_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  tableSession TableSession @relation(fields: [tableSessionId], references: [id])

  @@unique([tableSessionId, phone])
  @@map("table_session_participants")
}

/// Idempotency ledger for appending a round of items to an ALREADY-OPEN
/// session order (`OrderingService.appendItems`) — `Order.idempotencyKey`
/// only covers the order's own creation (one row, one key), so a retried
/// "add these items" request needs its own dedupe record instead of
/// silently appending the same round twice.
model OrderAppendLog {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  idempotencyKey String @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@map("order_append_logs")
}

// ============================================================================
// Ordering domain (Phase 4) — the heart of the system.
// Orders carry frozen snapshots of products/modifiers so menu changes never
// alter existing orders. All money is NUMERIC. Status transitions go through
// the central state machine and are recorded in order_status_history.
// ============================================================================

enum OrderStatus {
  new
  confirmed
  preparing
  ready
  served
  completed
  cancelled
  /// Reached only from `completed`, when a credit note refunds the FULL
  /// receipt total. A partial refund keeps the order `completed` — see
  /// the `refunds`/`credit_notes` tables.
  refunded

  @@map("order_status")
}

enum OrderType {
  dine_in
  takeaway
  walkin
  delivery

  @@map("order_type")
}

enum OrderSource {
  pos
  qr
  external_link
  delivery

  @@map("order_source")
}

model Order {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  /// Daily sequential number per branch (resets each day).
  orderNumber Int      @map("order_number")
  orderDate   DateTime @map("order_date") @db.Date

  type   OrderType
  source OrderSource
  status OrderStatus @default(new)

  /// Dine-in linkage: the table and its open session at order time.
  tableId        String? @map("table_id") @db.Uuid
  tableSessionId String? @map("table_session_id") @db.Uuid

  customerName  String? @map("customer_name")
  customerPhone String? @map("customer_phone")
  notes         String?

  /// VAT-inclusive amounts (SAR, NUMERIC — never float).
  subtotal  Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  vatRate   Decimal @map("vat_rate") @db.Decimal(5, 2)
  vatAmount Decimal @map("vat_amount") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  /// Idempotency: retried create requests return the original order.
  idempotencyKey String? @map("idempotency_key")

  /// Discount audit trail: percentage|fixed, raw value, reason, who.
  discountType   String?  @map("discount_type")
  discountValue  Decimal? @map("discount_value") @db.Decimal(12, 2)
  discountReason String?  @map("discount_reason")
  discountBy     String?  @map("discount_by") @db.Uuid

  /// null = guest (QR) order
  placedBy        String? @map("placed_by") @db.Uuid
  cancelledReason String? @map("cancelled_reason")

  /// Set only for orders ingested from a real delivery-platform webhook
  /// (source = "delivery") — the platform's own order id (also composes the
  /// idempotency key, so a retried/duplicate webhook never double-creates),
  /// which provider it came from, and the commission it charges, kept
  /// separate from `total` so reports can show gross revenue vs commission
  /// rather than netting it away silently.
  externalOrderId    String?  @map("external_order_id")
  deliveryProvider   String?  @map("delivery_provider")
  deliveryCommission Decimal? @map("delivery_commission") @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  branch               Branch                @relation(fields: [branchId], references: [id])
  table                Table?                @relation(fields: [tableId], references: [id])
  tableSession         TableSession?         @relation(fields: [tableSessionId], references: [id])
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  payments             Payment[]
  receipt              Receipt?
  refunds              Refund[]
  feedbackRequest      OrderFeedbackRequest?
  loyaltyLedgerEntries LoyaltyLedgerEntry[]
  appendLogs           OrderAppendLog[]

  @@unique([branchId, orderDate, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Frozen snapshot at order time: {name, nameEn, sku, price} —
  /// menu changes never alter existing orders.
  productSnapshot Json @map("product_snapshot")

  quantity  Int
  /// Unit price at order time (branch override applied), before modifiers.
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  /// (unitPrice + modifier adjustments) * quantity
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)
  notes     String?

  /// Shared table sessions only: the phone number of whoever ordered this
  /// specific line — null for every non-session order (walk-in/POS/
  /// takeaway/delivery), and for lines a cashier adds without picking a
  /// participant. This is what "split by item" bills against.
  participantPhone String? @map("participant_phone")
  /// How many of `quantity` units have been credited back via a per-item
  /// refund (`RefundsService` still issues the actual credit note — this
  /// only tracks how much of THIS line is still outstanding for splitting).
  refundedQuantity Int     @default(0) @map("refunded_quantity")

  /// Food-cost snapshot (Phase 7) — frozen at order time from the product's
  /// recipe and each ingredient's average cost, same rationale as the price
  /// snapshot above: later recipe/cost edits must not change past orders.
  /// Both null when the product has no recipe defined.
  unitCost Decimal? @map("unit_cost") @db.Decimal(12, 4)
  lineCost Decimal? @map("line_cost") @db.Decimal(12, 4)

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  order     Order               @relation(fields: [orderId], references: [id])
  product   Product             @relation(fields: [productId], references: [id])
  modifiers OrderItemModifier[]

  @@index([tenantId, orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  modifierId  String @map("modifier_id") @db.Uuid

  /// Frozen snapshot: {name, nameEn, groupName, groupNameEn}
  modifierSnapshot Json    @map("modifier_snapshot")
  priceAdjustment  Decimal @map("price_adjustment") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  @@index([tenantId, orderItemId])
  @@map("order_item_modifiers")
}

/// Every status transition: from/to/who/when — the basis for prep-time analytics.
model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  /// null = guest or system
  changedBy  String?      @map("changed_by") @db.Uuid
  reason     String?

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@map("order_status_history")
}

// ============================================================================
// Shifts & Payments domain (Phase 5) — cashier sessions, multi-payment
// checkout (cash/card/split), and the receipt foundation (pre-ZATCA).
// ============================================================================

/// Cashier shift: opening cash float, sales linkage, close foundation.
/// Full cash reconciliation reporting lands in Phase 8.
model Shift {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  openedBy String  @map("opened_by") @db.Uuid
  closedBy String? @map("closed_by") @db.Uuid

  openingCash  Decimal  @map("opening_cash") @db.Decimal(12, 2)
  /// Computed at close: openingCash + cash payments taken during the shift.
  expectedCash Decimal? @map("expected_cash") @db.Decimal(12, 2)
  actualCash   Decimal? @map("actual_cash") @db.Decimal(12, 2)
  difference   Decimal? @db.Decimal(12, 2)

  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch    @relation(fields: [branchId], references: [id])
  payments Payment[]
  refunds  Refund[]

  @@index([tenantId, branchId, closedAt])
  @@map("shifts")
}

enum PaymentMethod {
  cash
  card
  /// Paid through a digital-menu payment gateway (Moyasar/Tap/HyperPay) or
  /// remitted by a delivery platform on the customer's behalf — never a
  /// physical cash/card transaction, so shift cash reconciliation ignores it
  /// exactly like `card` already does.
  online

  @@map("payment_method")
}

enum PaymentStatus {
  /// A gateway checkout session was created; awaiting the provider's webhook.
  pending
  completed
  /// The gateway reported a failed/declined charge — the order falls back
  /// to "pay on delivery/pickup" rather than being blocked.
  failed
  voided

  @@map("payment_status")
}

/// One payment line. Split payment = multiple rows per order.
/// Payments are immutable business records (no updates, no soft delete);
/// corrections happen through voiding/credit notes in later phases.
model Payment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  orderId  String @map("order_id") @db.Uuid
  shiftId  String @map("shift_id") @db.Uuid

  method    PaymentMethod
  status    PaymentStatus @default(completed)
  amount    Decimal       @db.Decimal(12, 2)
  /// Card approval code / external reference.
  reference String?

  /// Idempotency: retried payment requests return the original row.
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
  shift  Shift  @relation(fields: [shiftId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, orderId])
  @@index([tenantId, shiftId])
  @@map("payments")
}

/// Receipt foundation — sequential per-branch numbering, frozen restaurant
/// info and VAT-ready fields. Thermal print layout consumes `payload`.
model Receipt {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  orderId  String @unique @map("order_id") @db.Uuid

  receiptNumber Int @map("receipt_number")

  /// Frozen snapshot: restaurant {name, vatNumber, cr, address}, branch,
  /// order lines, totals, payments.
  payload Json

  vatRate   Decimal @map("vat_rate") @db.Decimal(5, 2)
  vatAmount Decimal @map("vat_amount") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  /// ZATCA Phase 1: simplified-invoice QR content (TLV, Base64) —
  /// seller name, VAT number, timestamp, total incl. VAT, VAT amount.
  /// Still populated even when Phase 2 is enabled (Phase 2's QR is a
  /// superset, built once signing succeeds).
  qrPayload String? @map("qr_payload")

  /// ZATCA Phase 2 (see shared/zatca/*). Populated only when the tenant has
  /// zatcaPhase2Enabled — otherwise this stays exactly as Phase 1 always was.
  documentUuid        String    @unique @default(uuid()) @map("document_uuid") @db.Uuid
  /// true = Standard Tax Invoice (B2B/B2G, clearance flow); false = Simplified (B2C, reporting flow).
  isStandardInvoice   Boolean   @default(false) @map("is_standard_invoice")
  buyerName           String?   @map("buyer_name")
  buyerVatNumber      String?   @map("buyer_vat_number")
  /// Canonical UBL 2.1 XML this invoice was hashed/signed from (kept for
  /// audit + resubmission; XXE-safe because we only ever generate this
  /// XML ourselves, never parse externally-supplied XML into it).
  xmlContent          String?   @map("xml_content") @db.Text
  /// Per-branch hash chain (plan §9.3): SHA-256 of the canonical XML,
  /// chained via previousInvoiceHash to whatever document (invoice, credit
  /// or debit note) that branch issued immediately before this one.
  invoiceHash         String?   @map("invoice_hash")
  previousInvoiceHash String?   @map("previous_invoice_hash")
  /// XAdES-BES-style signature + the CSID cryptographic stamp, once signed.
  cryptographicStamp  String?   @map("cryptographic_stamp") @db.Text
  /// not_submitted (Phase 1, or Phase 2 disabled) | pending | cleared |
  /// reported | rejected.
  zatcaStatus         String    @default("not_submitted") @map("zatca_status")
  zatcaResponse       Json?     @map("zatca_response")
  zatcaSubmittedAt    DateTime? @map("zatca_submitted_at")

  issuedAt DateTime @default(now()) @map("issued_at")
  issuedBy String?  @map("issued_by") @db.Uuid

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  order       Order        @relation(fields: [orderId], references: [id])
  creditNotes CreditNote[]
  debitNotes  DebitNote[]
  refunds     Refund[]

  @@unique([branchId, receiptNumber])
  @@index([tenantId, branchId])
  @@map("receipts")
}

/// One credit note per refund (full or partial) against a completed
/// receipt — append-only, same tamper-evidence and ZATCA shape as Receipt.
/// Never updated/deleted: a mistaken credit note is corrected by issuing a
/// debit note, not by editing this row.
model CreditNote {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  receiptId String @map("receipt_id") @db.Uuid

  creditNoteNumber Int @map("credit_note_number")

  reason  String
  /// Frozen snapshot, same shape as Receipt.payload (restaurant/branch/order
  /// lines being credited, plus `reason`).
  payload Json

  subtotal  Decimal @db.Decimal(12, 2)
  vatRate   Decimal @map("vat_rate") @db.Decimal(5, 2)
  vatAmount Decimal @map("vat_amount") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  qrPayload String? @map("qr_payload")

  documentUuid        String    @unique @default(uuid()) @map("document_uuid") @db.Uuid
  isStandardInvoice   Boolean   @default(false) @map("is_standard_invoice")
  buyerName           String?   @map("buyer_name")
  buyerVatNumber      String?   @map("buyer_vat_number")
  xmlContent          String?   @map("xml_content") @db.Text
  invoiceHash         String?   @map("invoice_hash")
  previousInvoiceHash String?   @map("previous_invoice_hash")
  cryptographicStamp  String?   @map("cryptographic_stamp") @db.Text
  zatcaStatus         String    @default("not_submitted") @map("zatca_status")
  zatcaResponse       Json?     @map("zatca_response")
  zatcaSubmittedAt    DateTime? @map("zatca_submitted_at")

  issuedAt DateTime @default(now()) @map("issued_at")
  issuedBy String?  @map("issued_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  receipt Receipt @relation(fields: [receiptId], references: [id])
  refund  Refund?

  @@unique([branchId, creditNoteNumber])
  @@index([tenantId, receiptId])
  @@map("credit_notes")
}

/// Corrects an under-billed receipt (extra amount owed) — same append-only
/// shape as CreditNote. Rare in a POS context; mainly for B2B corrections.
/// Collecting the extra amount is a manual follow-up, out of scope here.
model DebitNote {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  receiptId String @map("receipt_id") @db.Uuid

  debitNoteNumber Int @map("debit_note_number")

  reason  String
  payload Json

  subtotal  Decimal @db.Decimal(12, 2)
  vatRate   Decimal @map("vat_rate") @db.Decimal(5, 2)
  vatAmount Decimal @map("vat_amount") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  qrPayload String? @map("qr_payload")

  documentUuid        String    @unique @default(uuid()) @map("document_uuid") @db.Uuid
  isStandardInvoice   Boolean   @default(false) @map("is_standard_invoice")
  buyerName           String?   @map("buyer_name")
  buyerVatNumber      String?   @map("buyer_vat_number")
  xmlContent          String?   @map("xml_content") @db.Text
  invoiceHash         String?   @map("invoice_hash")
  previousInvoiceHash String?   @map("previous_invoice_hash")
  cryptographicStamp  String?   @map("cryptographic_stamp") @db.Text
  zatcaStatus         String    @default("not_submitted") @map("zatca_status")
  zatcaResponse       Json?     @map("zatca_response")
  zatcaSubmittedAt    DateTime? @map("zatca_submitted_at")

  issuedAt DateTime @default(now()) @map("issued_at")
  issuedBy String?  @map("issued_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  receipt Receipt @relation(fields: [receiptId], references: [id])

  @@unique([branchId, debitNoteNumber])
  @@index([tenantId, receiptId])
  @@map("debit_notes")
}

/// The actual cash/card movement that hands money back to the customer,
/// always posted to the shift that is OPEN when the refund is processed
/// (never a retroactive edit of the shift the original payment belonged
/// to — that shift may already be closed and reconciled). Shift close
/// (shifts.service.ts) subtracts cash-method refunds from expected cash.
model Refund {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid
  orderId      String @map("order_id") @db.Uuid
  receiptId    String @map("receipt_id") @db.Uuid
  creditNoteId String @unique @map("credit_note_id") @db.Uuid
  shiftId      String @map("shift_id") @db.Uuid

  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id])
  receipt    Receipt    @relation(fields: [receiptId], references: [id])
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id])
  shift      Shift      @relation(fields: [shiftId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, shiftId])
  @@map("refunds")
}

/// One row per branch: the tip of that branch's ZATCA invoice hash chain,
/// shared across receipts, credit notes and debit notes (plan §9.3 — the
/// chain is per issuing unit, and this project treats "branch" as that
/// unit). Updated transactionally in the same transaction as each new
/// document, under a row lock, so concurrent POS terminals in one branch
/// never compute the same previousInvoiceHash twice.
model BranchInvoiceChain {
  branchId String @id @map("branch_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  lastHash String @map("last_hash")

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@map("branch_invoice_chains")
}

// ============================================================================
// Inventory & Recipe domain (Phase 7) — ingredients, stock locations/levels/
// movements, product recipes, and the food-cost snapshot on order items.
//
// Design notes:
// - Units of measure are a GLOBAL catalog (like `permissions`), seeded from
//   @spruvex-r/types — not tenant-owned, no RLS needed. Every ingredient
//   tracks stock in the canonical base unit of its measurement family
//   (grams for mass, milliliters for volume, pieces for count); recipe
//   quantities convert via `UnitOfMeasure.toBaseFactor`.
// - `stock_movements` is the ledger of truth (append-only, like payments/
//   receipts); `stock_levels` is a materialized running balance kept in
//   sync with every movement inside the same transaction, so reads stay
//   O(1) instead of summing the whole ledger.
// - Waste is a `stock_movements` row with type=waste (reason + performedBy
//   already on that table) rather than a separate table — avoids duplicating
//   the same fields in two places.
// - No separate `Recipe` header: `RecipeItem` rows attach directly to a
//   Product (the product is the recipe's aggregate root), matching plan
//   §9.3 "recipes (product ↔ ingredients + كميات)".
// ============================================================================

enum UnitType {
  mass
  volume
  count

  @@map("unit_type")
}

/// Global unit-of-measure catalog (seeded, not tenant-owned — see note above).
model UnitOfMeasure {
  id           String   @id @default(uuid()) @db.Uuid
  /// e.g. "g", "kg", "ml", "l", "pc" — stable machine key.
  code         String   @unique
  name         String
  nameEn       String   @map("name_en")
  type         UnitType
  /// How many base units (g / ml / pc) equal one of this unit. The base
  /// unit of each type has factor 1.
  toBaseFactor Decimal  @map("to_base_factor") @db.Decimal(12, 6)

  recipeItems RecipeItem[]

  @@map("units_of_measure")
}

model Ingredient {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Arabic name (primary)
  name         String
  nameEn       String?  @map("name_en")
  unitType     UnitType @map("unit_type")
  /// Moving average cost per BASE unit (SAR, NUMERIC — never float).
  averageCost  Decimal  @default(0) @map("average_cost") @db.Decimal(12, 4)
  /// Optional low-stock threshold (base units) for dashboard alerts.
  reorderLevel Decimal? @map("reorder_level") @db.Decimal(14, 3)
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  recipeItems          RecipeItem[]
  stockHides           ProductStockHide[]
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@index([tenantId])
  @@map("ingredients")
}

/// Physical stock location within a branch (main store, walk-in fridge, bar...).
model StockLocation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  name      String
  nameEn    String? @map("name_en")
  /// The location automated stock deduction (order.completed) writes to
  /// when a branch has more than one. Lazily created on first use.
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  branch    Branch          @relation(fields: [branchId], references: [id])
  levels    StockLevel[]
  movements StockMovement[]

  @@index([tenantId, branchId])
  @@map("stock_locations")
}

/// Materialized current balance per ingredient per location (base units).
model StockLevel {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid

  quantity Decimal @default(0) @db.Decimal(14, 3)

  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  branch     Branch        @relation(fields: [branchId], references: [id])
  location   StockLocation @relation(fields: [locationId], references: [id])
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id])

  @@unique([locationId, ingredientId])
  @@index([tenantId, branchId])
  @@map("stock_levels")
}

enum StockMovementType {
  purchase
  sale_deduction
  waste
  adjustment
  transfer_in
  transfer_out

  @@map("stock_movement_type")
}

/// Append-only stock ledger — the source of truth `stock_levels` is derived
/// from. Signed quantity (base units): positive = stock in, negative = out.
model StockMovement {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid
  locationId   String @map("location_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid

  type     StockMovementType
  /// Signed, base units (g / ml / pc).
  quantity Decimal           @db.Decimal(14, 3)
  /// Cost per base unit at the time of this movement (purchases only).
  unitCost Decimal?          @map("unit_cost") @db.Decimal(12, 4)

  /// e.g. referenceType="order" for automatic sale_deduction rows —
  /// the (type, referenceType, referenceId, ingredientId) tuple makes
  /// system-triggered deduction idempotent (see InventoryService).
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid
  /// Required for waste/adjustment at the DTO level.
  reason        String?
  /// null = system-triggered (automatic sale deduction on order completion).
  performedBy   String? @map("performed_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  branch     Branch        @relation(fields: [branchId], references: [id])
  location   StockLocation @relation(fields: [locationId], references: [id])
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id])

  @@unique([tenantId, type, referenceType, referenceId, ingredientId])
  @@index([tenantId, branchId, ingredientId, createdAt])
  @@index([tenantId, type])
  @@map("stock_movements")
}

/// Product ↔ ingredient recipe line. The product is the recipe's aggregate
/// root (no separate Recipe header table).
model RecipeItem {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid
  unitId       String @map("unit_id") @db.Uuid

  /// Quantity expressed in `unit` (converted to base units via toBaseFactor
  /// at costing/deduction time) — must be the same measurement family as
  /// the ingredient's unitType.
  quantity Decimal @db.Decimal(10, 3)
  notes    String?

  /// Marks this ingredient as make-or-break for the product: when its total
  /// branch stock falls to/below criticalThreshold (base units, null = 0),
  /// the product is auto-hidden at that branch (see ProductStockHide /
  /// InventoryService.reevaluateStockGating) — real availability gating,
  /// the same isAvailable flag POS/digital-menu already read, not a
  /// separate cosmetic flag.
  isCritical        Boolean  @default(false) @map("is_critical")
  criticalThreshold Decimal? @map("critical_threshold") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  product    Product       @relation(fields: [productId], references: [id])
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id])
  unit       UnitOfMeasure @relation(fields: [unitId], references: [id])

  @@unique([productId, ingredientId])
  @@index([tenantId, productId])
  @@map("recipe_items")
}

/// Tracks a product currently auto-hidden by the system because a critical
/// recipe ingredient (RecipeItem.isCritical) fell to/below its threshold at
/// this branch. The row's existence is the single source of truth for "the
/// SYSTEM, not the merchant, turned this off": InventoryService only ever
/// flips a product back on for a branch where a row is present, and a
/// merchant's own manual re-enable (products.service.setBranchSetting)
/// deletes the row so the system never fights their override. Deleted the
/// moment either stock recovers or the merchant manually re-enables.
model ProductStockHide {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  ingredientId String   @map("ingredient_id") @db.Uuid
  hiddenAt     DateTime @default(now()) @map("hidden_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, branchId])
  @@index([tenantId, branchId])
  @@map("product_stock_hides")
}

/// A vendor the tenant buys from. Deliberately minimal — no API integration
/// exists yet (manual invoice entry only, see PurchaseInvoice), but nothing
/// here blocks adding one later (e.g. an externalId/provider column) without
/// restructuring.
model Supplier {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name         String
  nameEn       String? @map("name_en")
  /// Optional — a supplier not registered for VAT has none.
  vatNumber    String? @map("vat_number")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")
  address      String?
  notes        String?
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  purchaseInvoices PurchaseInvoice[]

  @@index([tenantId])
  @@map("suppliers")
}

enum PurchaseInvoiceStatus {
  draft
  confirmed
  cancelled

  @@map("purchase_invoice_status")
}

enum PurchaseInvoiceItemType {
  stock
  expense

  @@map("purchase_invoice_item_type")
}

/// A manually-entered supplier tax invoice — the input-VAT source of truth
/// for the VAT return (reports/vat-return.service.ts). Confirming posts each
/// line to the SAME real ledgers everything else uses (InventoryService
/// stock receiving for "stock" lines, Expense for "expense" lines) — this
/// table is never itself an alternate accounting record, only the
/// manually-entered document that drives those real postings exactly once
/// (see PurchasesService.confirm's row-locked, idempotent transaction).
///
/// Deliberately no PO/GRN linkage yet (three-way match) — supplierId +
/// supplierInvoiceNumber is the only cross-document key today, but nothing
/// here (e.g. a future purchaseOrderId column) requires restructuring this
/// table to add one.
model PurchaseInvoice {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  branchId   String @map("branch_id") @db.Uuid
  supplierId String @map("supplier_id") @db.Uuid

  /// The supplier's own invoice number (not our sequential numbering) —
  /// what the accountant matches back to the physical/PDF document.
  supplierInvoiceNumber String                @map("supplier_invoice_number")
  invoiceDate           DateTime              @map("invoice_date") @db.Date
  status                PurchaseInvoiceStatus @default(draft)

  /// VAT-EXCLUSIVE net amounts (supplier tax invoices are priced net + VAT
  /// on top) — the opposite convention from Order/Receipt, which are
  /// VAT-inclusive gross. Always derived from items server-side, never
  /// trusted from the request.
  subtotal  Decimal @db.Decimal(12, 2)
  vatAmount Decimal @map("vat_amount") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  /// Optional scan/photo of the original supplier invoice — private
  /// storage, never the public /uploads/ path (see UploadsService).
  attachmentUrl      String? @map("attachment_url")
  attachmentFilename String? @map("attachment_filename")
  notes              String?

  confirmedAt  DateTime? @map("confirmed_at")
  confirmedBy  String?   @map("confirmed_by") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  supplier Supplier              @relation(fields: [supplierId], references: [id])
  items    PurchaseInvoiceItem[]

  /// The same supplier invoice must never be entered twice.
  @@unique([tenantId, supplierId, supplierInvoiceNumber])
  @@index([tenantId, branchId, invoiceDate])
  @@index([tenantId, status])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  purchaseInvoiceId String @map("purchase_invoice_id") @db.Uuid

  description String
  itemType    PurchaseInvoiceItemType @map("item_type")

  quantity       Decimal @db.Decimal(14, 3)
  /// Net (pre-VAT) price per unit of `quantity`.
  unitPrice      Decimal @map("unit_price") @db.Decimal(12, 4)
  /// Editable per line, defaulting from settings.defaultPurchaseVatRate —
  /// never a hardcoded rate (see PurchasesService).
  vatRatePercent Decimal @map("vat_rate_percent") @db.Decimal(5, 2)

  lineSubtotal Decimal @map("line_subtotal") @db.Decimal(12, 2)
  lineVat      Decimal @map("line_vat") @db.Decimal(12, 2)
  lineTotal    Decimal @map("line_total") @db.Decimal(12, 2)

  /// "stock" lines only — which ingredient/location this receives into.
  /// Quantity/unitPrice are in the ingredient's BASE unit, same convention
  /// the existing manual stock-purchase form already uses.
  ingredientId String? @map("ingredient_id") @db.Uuid
  locationId   String? @map("location_id") @db.Uuid

  /// "expense" lines only — free-text bucket (rent/utilities/maintenance/...),
  /// deliberately not an enum so new categories never need a code change.
  expenseCategory String? @map("expense_category")

  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  ingredient      Ingredient?     @relation(fields: [ingredientId], references: [id])

  @@index([tenantId, purchaseInvoiceId])
  @@map("purchase_invoice_items")
}

/// The tenant's first real operational-expense ledger — nothing like it
/// existed before (see vat-return.service.ts's prior "no input-VAT tracking"
/// note). Posted exactly once per confirmed "expense" PurchaseInvoiceItem
/// (referenceType/referenceId is the same idempotency convention
/// StockMovement already uses for its system-triggered rows).
model Expense {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  /// Free-text bucket, same non-enum reasoning as PurchaseInvoiceItem.
  category    String?
  description String
  /// Net (pre-VAT) amount.
  amount      Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @default(0) @map("vat_amount") @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  incurredAt DateTime @map("incurred_at") @db.Date

  /// e.g. referenceType="purchase_invoice_item" for expenses posted from a
  /// confirmed purchase invoice line — null referenceType/referenceId means
  /// a manually-entered expense (future extension point; not built yet).
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, referenceType, referenceId])
  @@index([tenantId, branchId, incurredAt])
  @@map("expenses")
}

/// Post-order WhatsApp rating request. Created the moment an order reaches
/// "completed" (FeedbackOrderListener), sent ~30 minutes later once
/// sendAfter passes (FeedbackService's polling sender — a due row is one
/// with sendAfter <= now and sentAt still null), and answered through the
/// public capability-token link the WhatsApp template carries (id doubles
/// as the token, same convention as Receipt/public order tracking).
/// rating/comment stay null until the customer actually responds.
model OrderFeedbackRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  orderId  String @unique @map("order_id") @db.Uuid

  /// Best-effort "main item" of the order (highest line total) — purely
  /// informational context for the dashboard, never enforced.
  primaryProductId String? @map("primary_product_id") @db.Uuid

  sendAfter DateTime  @map("send_after")
  sentAt    DateTime? @map("sent_at")

  rating  Int?      @db.SmallInt
  comment String?
  ratedAt DateTime? @map("rated_at")

  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  branch         Branch   @relation(fields: [branchId], references: [id])
  order          Order    @relation(fields: [orderId], references: [id])
  primaryProduct Product? @relation(fields: [primaryProductId], references: [id])

  @@index([tenantId, branchId, ratedAt])
  @@index([sendAfter, sentAt])
  @@map("order_feedback_requests")
}

// ---------------------------------------------------------------------------
// Billing (Phase 8) — plans, subscriptions, subscription invoices.
// No payment gateway is wired yet: activation is manual (bank transfer/
// invoice), matching the plan doc's MVP decision. The shape is ready for a
// gateway integration later (external customer/subscription id columns).
// ---------------------------------------------------------------------------

/// Global plan catalog — not tenant-owned, no RLS (same pattern as
/// UnitOfMeasure/Permission). Seeded from a fixed catalog, read-only to the app role.
model Plan {
  id     String  @id @default(uuid()) @db.Uuid
  key    String  @unique
  name   String
  nameEn String? @map("name_en")

  /// Feature limits (Phase 8 foundation). Null = unlimited.
  maxBranches       Int  @map("max_branches")
  maxUsers          Int  @map("max_users")
  maxOrdersPerMonth Int? @map("max_orders_per_month")

  priceMonthlyHalalas Int  @map("price_monthly_halalas")
  priceYearlyHalalas  Int? @map("price_yearly_halalas")
  /// Free-form feature flags (JSONB) — e.g. {"inventory": true, "multiKds": false}.
  features            Json @default("{}")

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled

  @@map("subscription_status")
}

/// One subscription per tenant. Trial/limits/status are the enforcement
/// source of truth for TenantAccessGuard and LimitsService.
model Subscription {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid

  status             SubscriptionStatus @default(trialing)
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")

  /// Reserved for a future payment gateway integration (e.g. Stripe/Moyasar
  /// customer + subscription ids) — unused today, kept nullable on purpose.
  externalCustomerId     String? @map("external_customer_id")
  externalSubscriptionId String? @map("external_subscription_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  plan     Plan                  @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]

  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionInvoiceStatus {
  pending
  paid
  failed
  void

  @@map("subscription_invoice_status")
}

/// Append-only billing record for a subscription period. Manually marked
/// paid today (bank transfer); a gateway webhook would do the same update
/// later without changing this shape.
model SubscriptionInvoice {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid

  amountHalalas Int                       @map("amount_halalas")
  status        SubscriptionInvoiceStatus @default(pending)
  periodStart   DateTime                  @map("period_start")
  periodEnd     DateTime                  @map("period_end")
  paidAt        DateTime?                 @map("paid_at")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, createdAt])
  @@map("subscription_invoices")
}

// ---------------------------------------------------------------------------
// Platform (Phase 8) — SpruVex operations team, entirely separate from
// tenant RBAC. No RLS (global, cross-tenant by design); authenticated with
// its own JWT type ("platform_admin") that tenant guards never accept.
// ---------------------------------------------------------------------------

model PlatformAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")

  /// Same brute-force lockout as User (identity/auth.service.ts) — the
  /// highest-privilege account in the system deserves the same protection.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_admins")
}

// ---------------------------------------------------------------------------
// Integrations & add-ons — delivery platforms, digital-menu payment gateways,
// NFC card terminals, WhatsApp. Every connection stores its own credentials
// (AES-256-GCM encrypted, see shared/security/crypto-vault.ts) and never
// creates a side data path: a delivery-platform webhook or a gateway's
// successful checkout both flow through the SAME OrderingService.create()/
// PaymentsService used by the POS and the customer ordering app, so stock
// deduction, KDS visibility, reports, and refunds all just work.
// ---------------------------------------------------------------------------

enum IntegrationCategory {
  delivery_platform
  payment_gateway
  nfc_terminal
  whatsapp

  @@map("integration_category")
}

/// One connection = one (tenant [+ branch], category, provider) triple.
/// branchId is set for connections that are inherently tied to one physical
/// location (a delivery-platform store listing, an NFC terminal sitting at
/// one counter) and null for connections that belong to the business as a
/// whole (one payment-gateway merchant account, one WhatsApp Business number).
model IntegrationConnection {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  category IntegrationCategory
  /// "hungerstation" | "moyasar" | "tap" | "hyperpay" | "geidea" | "whatsapp_cloud" | ...
  provider String

  isEnabled   Boolean @default(false) @map("is_enabled")
  /// "test" | "live" — meaningful for payment gateways; ignored otherwise.
  environment String  @default("test")

  /// Non-secret settings: external store id, phone number id, business
  /// display name, terminal id, publishable/public key, etc.
  config Json @default("{}")

  /// The provider's main API key/access token/secret key — encrypted.
  /// Never selected into any API response.
  secretEnc        String? @map("secret_enc") @db.Text
  /// A second secret some providers need for verifying inbound webhooks,
  /// distinct from the main API key — encrypted.
  webhookSecretEnc String? @map("webhook_secret_enc") @db.Text

  lastVerifiedAt   DateTime? @map("last_verified_at")
  lastSyncedAt     DateTime? @map("last_synced_at")
  /// Drives the dashboard's connection-status badge ("key error" etc.) —
  /// never stores the secret itself, only a human-readable failure reason.
  lastErrorMessage String?   @map("last_error_message")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  branch          Branch?                  @relation(fields: [branchId], references: [id])
  productMappings DeliveryProductMapping[]

  @@unique([tenantId, branchId, category, provider])
  @@index([tenantId, category])
  @@map("integration_connections")
}

/// Maps an internal catalog product to a delivery platform's own item id, so
/// an incoming webhook order (which only knows the platform's ids) resolves
/// to a real productId before it ever reaches OrderingService.create().
/// Populated by the owner once per product (no live partner API access to
/// auto-sync against in this environment — see the delivery-integration
/// module's doc comment for what a real push-sync would need).
model DeliveryProductMapping {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  connectionId String @map("connection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid

  externalItemId   String  @map("external_item_id")
  externalItemName String? @map("external_item_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product    Product               @relation(fields: [productId], references: [id])

  @@unique([connectionId, externalItemId])
  @@unique([connectionId, productId])
  @@map("delivery_product_mappings")
}

/// Per-tenant customization of one system-defined WhatsApp message template
/// (the catalog itself is code, see @spruvex-r/types' WHATSAPP_MESSAGE_TEMPLATES).
/// WhatsApp requires templates to be pre-approved by Meta before they can be
/// sent outside a customer-initiated 24h window — approvalStatus reflects
/// what happened in the tenant's own Meta Business Manager, set manually;
/// this system has no live Meta credentials to verify it automatically.
model WhatsappTemplateOverride {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  templateKey String @map("template_key")

  customBodyAr     String? @map("custom_body_ar")
  /// "not_submitted" | "pending" | "approved" | "rejected"
  approvalStatus   String  @default("not_submitted") @map("approval_status")
  /// The exact template name registered in Meta Business Manager — required
  /// to actually send (Meta addresses templates by name, not by our key).
  metaTemplateName String? @map("meta_template_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, templateKey])
  @@map("whatsapp_template_overrides")
}

// ---------------------------------------------------------------------------
// Loyalty program — stamp cards, spend-threshold discounts, points-per-riyal,
// and membership tiers. Every earn/redeem is a REAL order mutation (a real
// discount via OrderingService.applyDiscount, or a real $0 line via
// OrderingService.addComplimentaryItem) — this schema only tracks the
// customer's running balance and an auditable ledger, never a parallel price.

enum LoyaltyProgramType {
  stamp_card
  spend_threshold
  points_per_riyal
  tier

  @@map("loyalty_program_type")
}

/// One program's rules. branchId = null applies tenant-wide; a specific
/// branchId overrides the tenant-wide row for just that branch (same nullable
/// pattern as IntegrationConnection). isEnabled is the "pause without losing
/// data" toggle — the config and every customer's accumulated balance survive
/// a merchant turning a program off and back on.
model LoyaltyProgramConfig {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  type      LoyaltyProgramType
  isEnabled Boolean            @default(true) @map("is_enabled")

  /// Shape depends on `type` (validated at the DTO layer):
  /// stamp_card: { stampsRequired, earnProductId?, earnCategoryId?, rewardProductId }
  /// spend_threshold: { thresholdAmount, discountPercent, resetPeriod: "monthly"|"yearly"|"none", carryOver }
  /// points_per_riyal: { pointsPerRiyal, redemptionPointsUnit, redemptionSarValue }
  /// tier: { tiers: [{ key, nameAr, nameEn, minSpend, discountPercent }, ...] }
  config Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, type])
  @@index([tenantId, type])
  @@map("loyalty_program_configs")
}

/// One customer's loyalty identity + running balances, keyed by phone number
/// ONLY (no separate account/login) — the same number used for ordering and
/// WhatsApp. Shared across all of the tenant's branches: a customer's stamps/
/// points/spend/tier follow them between branches, while each branch's
/// LoyaltyProgramConfig decides whether earning/redemption is active there.
model LoyaltyCustomer {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  /// Same format as Order.customerPhone.
  phone    String
  /// Last known name, opportunistically updated from orders.
  name     String?

  stampCount Int @default(0) @map("stamp_count")

  /// Toward the current spend_threshold cycle — reset per its resetPeriod/carryOver.
  spendAccumulated Decimal   @default(0) @map("spend_accumulated") @db.Decimal(12, 2)
  spendPeriodStart DateTime? @map("spend_period_start")

  pointsBalance Int @default(0) @map("points_balance")

  /// Never resets — the sole input to tier calculation.
  lifetimeSpend Decimal @default(0) @map("lifetime_spend") @db.Decimal(12, 2)
  /// Cached current tier key (from the tier config's `tiers[].key`); recomputed on every earn.
  tierKey       String? @map("tier_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  ledgerEntries LoyaltyLedgerEntry[]

  @@unique([tenantId, phone])
  @@map("loyalty_customers")
}

enum LoyaltyLedgerType {
  stamp_earned
  stamp_redeemed
  stamp_reversed
  spend_accrued
  spend_redeemed
  spend_reversed
  points_earned
  points_redeemed
  points_reversed
  tier_changed

  @@map("loyalty_ledger_type")
}

/// Append-only audit trail for every balance change — the basis for refund/
/// cancellation reversal (find every entry tied to orderId and undo it) and
/// for the audit log the merchant can inspect per customer.
model LoyaltyLedgerEntry {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  branchId   String  @map("branch_id") @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  /// The invoice/order that triggered this entry (earn or redeem) — null for
  /// a manual adjustment with no order context.
  orderId    String? @map("order_id") @db.Uuid

  type   LoyaltyLedgerType
  /// Signed delta on the counter `type` refers to (stamps/points/SAR) —
  /// interpretation depends on `type`; never itself a price.
  amount Decimal           @db.Decimal(12, 3)
  /// Free-form context, e.g. { rewardProductId } or { tierFrom, tierTo }.
  meta   Json              @default("{}")

  createdAt   DateTime @default(now()) @map("created_at")
  /// null = system/automatic; set = the cashier who triggered a manual redemption.
  performedBy String?  @map("performed_by") @db.Uuid

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  branch   Branch          @relation(fields: [branchId], references: [id])
  customer LoyaltyCustomer @relation(fields: [customerId], references: [id])
  order    Order?          @relation(fields: [orderId], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, orderId])
  @@map("loyalty_ledger_entries")
}
