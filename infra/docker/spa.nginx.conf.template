server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Proxied to the API. ${API_INTERNAL_ORIGIN} (a FULL origin including
  # scheme, e.g. `http://api:3000` for docker-compose or
  # `https://spruvex-r-api.onrender.com` on a platform without
  # Compose-style service-name DNS) is substituted at container startup by
  # nginx's built-in template processing (this file lives in
  # /etc/nginx/templates/, which the official nginx image envsubst's into
  # /etc/nginx/conf.d/ automatically — see docker-entrypoint.d in the base
  # image). Only real environment variables get substituted — nginx's own
  # $host, $remote_addr, etc. below are untouched (verified against the
  # official image's envsubst invocation, which restricts substitution to
  # the process environment).
  #
  # The upstream is assigned to a variable (not a bare proxy_pass target)
  # so nginx resolves it per-request via `resolver` instead of once at
  # config load — a bare proxy_pass to an unresolvable host makes nginx
  # exit immediately with "host not found in upstream", which happened
  # deploying against Render's internal service DNS. Resolving against
  # public DNS and going out over the public internet to the API's public
  # onrender.com URL sidesteps that internal-DNS timing/availability issue
  # entirely.
  resolver 1.1.1.1 8.8.8.8 valid=30s;

  location /api/ {
    # With a variable proxy_pass target, nginx does NOT do location-prefix
    # substitution — it passes the ORIGINAL request URI unchanged. So the
    # variable must carry the full destination and we must not append a path
    # here (appending /api/ truncated the URI to /api/ and NestJS 404'd
    # with "Cannot GET /api/"). The SPA already calls same-origin /api/v1/...,
    # which is exactly the path the API expects — forward it verbatim.
    set $upstream_api ${API_INTERNAL_ORIGIN};
    proxy_pass $upstream_api;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;
    # Host must be the upstream's own host, NOT $host: Render's edge routes
    # by Host header, so forwarding the dashboard's host makes Render route
    # the request right back to this same dashboard service — an infinite
    # proxy loop Render eventually cuts off with 508 Loop Detected (this
    # exact failure broke dashboard login in production).
    proxy_set_header Host spruvex-r-api.onrender.com;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # WebSocket upgrade for Socket.io (KDS / POS realtime).
  location /socket.io/ {
    set $upstream_ws ${API_INTERNAL_ORIGIN};
    proxy_pass $upstream_ws;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    # Same 508-loop + verbatim-URI fixes as /api/ above.
    proxy_set_header Host spruvex-r-api.onrender.com;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  gzip on;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
}
